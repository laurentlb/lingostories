{"inkVersion":21,"root":[["^The Body ","#","^title","/#","\n","^$image lesson5-body.jpg","\n","^A person has a body.","\n","^The body has two arms and two legs.","\n","^Each arm has a hand.","\n","^Each leg has a foot.","\n","^A person has two hands and two feet.","\n","^How many arms does a person have?","\n","ev","str","^Two. ","#","^ok","/#","/str","/ev",{"*":"0.c-0","flg":20},"ev","str","^One. ","#","^fail","/#","/str","/ev",{"*":"0.c-1","flg":20},{"c-0":["\n",{"->":"0.g-0"},{"#f":5}],"c-1":["\n",{"->":"0.g-0"},{"#f":5}],"g-0":["^A person has two arms.","\n","^How many legs does a person have?","\n","ev","str","^Two. ","#","^ok","/#","/str","/ev",{"*":".^.c-2","flg":20},"ev","str","^Three. ","#","^fail","/#","/str","/ev",{"*":".^.c-3","flg":20},{"c-2":["\n",{"->":"0.g-1"},{"#f":5}],"c-3":["\n",{"->":"0.g-1"},{"#f":5}]}],"g-1":["^A person has two legs.","\n","^Each hand has five fingers.","\n","^Each foot has five toes.","\n","^How many fingers does one hand have?","\n","ev","str","^Five. ","#","^ok","/#","/str","/ev",{"*":".^.c-4","flg":20},"ev","str","^Ten. ","#","^fail","/#","/str","/ev",{"*":".^.c-5","flg":20},{"c-4":["\n",{"->":"0.g-2"},{"#f":5}],"c-5":["\n",{"->":"0.g-2"},{"#f":5}]}],"g-2":["^One hand has five fingers.","\n","^How many fingers do two hands have?","\n","ev","str","^Ten. ","#","^ok","/#","/str","/ev",{"*":".^.c-6","flg":20},"ev","str","^Eight. ","#","^fail","/#","/str","/ev",{"*":".^.c-7","flg":20},{"c-6":["\n",{"->":"0.g-3"},{"#f":5}],"c-7":["\n",{"->":"0.g-3"},{"#f":5}]}],"g-3":["^Two hands have ten fingers.","\n","^How many toes do two feet have?","\n","ev","str","^Ten. ","#","^ok","/#","/str","/ev",{"*":".^.c-8","flg":20},"ev","str","^Five. ","#","^fail","/#","/str","/ev",{"*":".^.c-9","flg":20},{"c-8":["\n",{"->":"0.g-4"},{"#f":5}],"c-9":["\n",{"->":"0.g-4"},{"#f":5}]}],"g-4":["^Two feet have ten toes.","\n","^$image lesson5-head.jpg","\n","^The body also has a head.","\n","^The head is at the top of the body.","\n","^The neck is between the head and the body.","\n","^The face is at the front of the head.","\n","^A face has two eyes, one nose, and one mouth.","\n","^The ears are on the sides of the head.","\n","^There is hair on top of the head.","\n","^Where are the eyes?","\n","ev","str","^In the face. ","#","^ok","/#","/str","/ev",{"*":".^.c-10","flg":20},"ev","str","^On the hands. ","#","^fail","/#","/str","/ev",{"*":".^.c-11","flg":20},{"c-10":["\n",{"->":"0.g-5"},{"#f":5}],"c-11":["\n",{"->":"0.g-5"},{"#f":5}]}],"g-5":["^The eyes are in the face.","\n","^Where are the ears?","\n","ev","str","^On the head. ","#","^ok","/#","/str","/ev",{"*":".^.c-12","flg":20},"ev","str","^On the legs. ","#","^fail","/#","/str","/ev",{"*":".^.c-13","flg":20},{"c-12":["\n",{"->":"0.g-6"},{"#f":5}],"c-13":["\n",{"->":"0.g-6"},{"#f":5}]}],"g-6":["^The ears are on the head.","\n","^The stomach is at the front of the body.","\n","^The back is on the other side of the body.","\n","^$image lesson5-family-body.jpg","\n","^Mrs. Smith has long hair.","\n","^Helen has long hair too.","\n","^John has short hair.","\n","^Mrs. Smith's hair is longer than Helen's hair.","\n","^Who has short hair?","\n","ev","str","^John. ","#","^ok","/#","/str","/ev",{"*":".^.c-14","flg":20},"ev","str","^Helen. ","#","^fail","/#","/str","/ev",{"*":".^.c-15","flg":20},{"c-14":["\n",{"->":"0.g-7"},{"#f":5}],"c-15":["\n",{"->":"0.g-7"},{"#f":5}]}],"g-7":["^John has short hair.","\n","^Who has the longest hair in the family?","\n","ev","str","^Mrs. Smith. ","#","^ok","/#","/str","/ev",{"*":".^.c-16","flg":20},"ev","str","^Helen. ","#","^fail","/#","/str","/ev",{"*":".^.c-17","flg":20},"ev","str","^John. ","#","^fail","/#","/str","/ev",{"*":".^.c-18","flg":20},{"c-16":["\n",{"->":"0.g-8"},{"#f":5}],"c-17":["\n",{"->":"0.g-8"},{"#f":5}],"c-18":["\n",{"->":"0.g-8"},{"#f":5}]}],"g-8":["^Mrs. Smith has the longest hair in the family.","\n","^Emma is a baby.","\n","^Her hands and feet are very small.","\n","^Is Emma a boy or a girl?","\n","ev","str","^She is a girl. ","#","^ok","/#","/str","/ev",{"*":".^.c-19","flg":20},"ev","str","^He is a boy. ","#","^fail","/#","/str","/ev",{"*":".^.c-20","flg":20},{"c-19":["\n",{"->":"0.g-9"},{"#f":5}],"c-20":["\n",{"->":"0.g-9"},{"#f":5}]}],"g-9":["^Emma is a girl.","\n","^Dialogue ","#","^title","/#","\n","^@helen John, how many fingers do you have?","\n","^@john Ten. Five on each hand.","\n","^@helen Mom, where is Emma's nose?","\n","^@mrs_smith Here it is. It is very small!","\n","end",["done",{"#n":"g-10"}],null]}],"done",null],"listDefs":{}}